{
  "name": "bilinear",
  "version": "0.3.0",
  "private": true,
  "description": "Linear-style issue tracker for Obsidian, stored as plain Markdown notes",
  "license": "GPL-2.0-only",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.cli.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build:cli": "vite build --config vite.cli.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  }
}
